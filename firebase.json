{
  "hosting": {
    "site": "uptier-502917",
    "public": ".firebase-site",
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      },
      {
        "source": "/auth/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "private, no-store, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
